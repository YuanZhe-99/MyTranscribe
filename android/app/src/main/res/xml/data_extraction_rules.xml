<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and later. Downloaded local
     models are a re-downloadable cache measured in gigabytes; they go neither
     to the cloud nor to a new phone. See doc/en-us/platform-notes.md. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/MyTranscribe/models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/MyTranscribe/models/" />
    </device-transfer>
</data-extraction-rules>
